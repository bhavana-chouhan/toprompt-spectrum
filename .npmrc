engine-strict=false
loglevel=error
node-linker=hoisted
# Phase 2 monorepo: keep each package's own pnpm-lock.yaml so the Docker pre-bake
# (separate /base + /base-api caches) keeps working. Shared lockfile would force
# a single root lockfile and invalidate pre-baked node_modules.
shared-workspace-lockfile=false
# If we ever add cross-package deps (e.g. shared Zod types), resolve to workspace siblings first.
prefer-workspace-packages=true
